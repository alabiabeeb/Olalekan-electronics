# Copy this file to .env and change the values.
# On Vercel, set the same names under Project → Settings → Environment Variables.
PORT=3000

# Password for the admin dashboard at /admin — change this before going live.
ADMIN_PASSWORD=change-me

# Long random string used to sign admin logins (optional locally, recommended on Vercel).
SESSION_SECRET=

# WhatsApp number orders are forwarded to (international format, digits only).
WHATSAPP_NUMBER=2348057185714

# Hosted database (Turso). Leave empty locally to use server/data/store.db.
# Vercel fills these in automatically when you connect a Turso database under Storage.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob token for product photo uploads. Leave empty locally to save to public/uploads.
# Vercel fills this in automatically when you connect a Blob store under Storage.
BLOB_READ_WRITE_TOKEN=
